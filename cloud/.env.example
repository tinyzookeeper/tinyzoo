# Postgres for the cloud's own data (accounts, sites). With the local hosting driver the same
# server also holds each site's database (tzc_<slug>), so this user must be allowed to create databases.
NUXT_DATABASE_URL=postgres://cms:cms@localhost:5434/tz_cloud_dev
# Seals the sign-in cookie (32+ characters).
NUXT_APP_SECRET=change-me-to-32-or-more-random-characters
# Encrypts what the cloud keeps about each site (its secrets, the invitation link). 32+ characters.
# Keep it: a new one makes them unreadable.
NUXT_CLOUD_SECRET=change-me-to-another-32-or-more-random-characters
# The cloud's own address: for links in e-mails, and the issuer address every website is told for
# sign-in through the account (the websites' servers must be able to reach it).
NUXT_PUBLIC_URL=http://localhost:3200
# How long a one-time code of a sign-in through the account works. 60 seconds, and never more.
# NUXT_ACCOUNT_CODE_TTL_SECONDS=60
# How many websites one account may have.
NUXT_MAX_SITES_PER_USER=3
# true: a website is made only after the e-mail is confirmed. Default: false in development, true in production.
NUXT_REQUIRE_VERIFIED_EMAIL=false
# true shows the planned templates in the gallery, marked as not available yet. Customers never see them without it.
NUXT_PUBLIC_SHOW_PLANNED=true
# Where websites run: local (a process per website on this machine), shared (one process per
# template serves all its websites) or pushbase (written, not exercised).
NUXT_HOSTING_DRIVER=local
# The local driver's ports, one per website.
NUXT_HOSTING_LOCAL_PORT_FROM=4300
NUXT_HOSTING_LOCAL_PORT_TO=4399
# The pattern of the sites' public addresses. Default: http://{slug}.localhost:{port}.
# NUXT_HOSTING_LOCAL_PUBLIC_URL=https://{slug}.pushbase.app
# The shared driver: one port per template, and what the sites' databases and database users are
# called before the site's id. It makes a Postgres user and a database for every website, so the
# user of NUXT_DATABASE_URL must be allowed to create users and databases and to hand a database
# to another user (a superuser covers it).
# NUXT_HOSTING_SHARED_PORT_FROM=4400
# NUXT_HOSTING_SHARED_PORT_TO=4419
# NUXT_HOSTING_SHARED_DATABASE_PREFIX=tzs
# NUXT_HOSTING_SHARED_DATA_DIR=
# Where the shared driver keeps the site directory: file (sites.json in each template's folder) or
# postgres (the table tenant_sites in this database; each template's process reads it with a
# role of its own that may read that table and nothing else).
# NUXT_HOSTING_SHARED_DIRECTORY=file
# Encrypts every secret in the site directory (32+ characters). Required for postgres; with file,
# without it, sites.json holds the sites' database passwords in plain text. Keep it.
# NUXT_HOSTING_SHARED_DIRECTORY_KEY=change-me-to-a-third-32-or-more-random-characters
# Where a customer's own domain must lead before it is used: a host name (the target of a CNAME)
# and/or IP addresses, separated by commas. Outside production a *.localhost name needs none.
# NUXT_HOSTING_DOMAIN_TARGET=sites.example.com,203.0.113.7
# The largest archive of a website that is taken in ("Move a website here"), in MB.
# NUXT_HOSTING_IMPORT_MAX_MB=2048
# Moving a website runs `tinyzoo backup` and `restore`, which need pg_dump, pg_restore and psql.
# On a machine that has Postgres only in a container, these wrappers run them inside it:
# TINYZOO_PG_DUMP=/absolute/path/to/cloud/scripts/pg-tools/pg_dump
# TINYZOO_PG_RESTORE=/absolute/path/to/cloud/scripts/pg-tools/pg_restore
# TINYZOO_PSQL=/absolute/path/to/cloud/scripts/pg-tools/psql
# TINYZOO_PG_CONTAINER=my-cms-postgres-1
# The account the cloud keeps on every website, to act on it later.
NUXT_SERVICE_EMAIL=cloud@tinyzoo.invalid
# E-mail: log (print only; links show on the page in development) or smtp.
NUXT_MAIL_TRANSPORT=log
NUXT_MAIL_FROM=
NUXT_MAIL_SMTP_HOST=
NUXT_MAIL_SMTP_PORT=587
NUXT_MAIL_SMTP_SECURE=false
NUXT_MAIL_SMTP_REQUIRE_TLS=true
NUXT_MAIL_SMTP_USER=
NUXT_MAIL_SMTP_PASS=
