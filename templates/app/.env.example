# The one app runs in multi-tenant mode only: `pnpm dev <design>` (scripts/dev.mjs) writes a
# site directory with one site and starts the development server with it. It reads:
#   DATABASE_URL        the Postgres server for the site's database (a database of its own is made)
#   NUXT_APP_SECRET     at least 32 characters
DATABASE_URL=postgres://cms:cms@localhost:5434/postgres
NUXT_APP_SECRET=change-me-to-a-long-random-string-32-chars-min
