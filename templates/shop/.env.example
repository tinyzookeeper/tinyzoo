# Settings for development (copy to .env). A site made by the cloud gets its own from the cloud.
DATABASE_URL=postgres://cms:cms@localhost:5434/tz_tpl_shop_dev
# At least 32 characters; the admin's sign-in cookie is sealed with a key derived from it.
NUXT_APP_SECRET=change-me-to-a-long-random-string-32-chars-min
