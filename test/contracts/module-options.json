{
  "module": {
    "meta": {
      "name": "tinyzoo",
      "configKey": "cms"
    },
    "defaults": {
      "config": "cms.config.ts"
    },
    "moduleDependencies": {
      "@nuxtjs/sitemap": {
        "version": ">=9.1.0",
        "defaults": {
          "exclude": [
            "/admin",
            "/admin/**"
          ],
          "cacheMaxAgeSeconds": 3600
        }
      }
    }
  },
  "runtimeConfig.cms": {
    "databaseUrl": "",
    "migrations": {
      "onStart": false
    },
    "redis": {
      "url": "",
      "prefix": ""
    },
    "revisions": {
      "keep": 50
    },
    "retention": {
      "auditDays": 365
    },
    "webhooks": {
      "urls": "",
      "secret": ""
    },
    "sitemap": {
      "paths": []
    },
    "auth": {
      "mode": "builtin",
      "trustedProxies": 1,
      "ipHeader": "",
      "setupToken": ""
    },
    "publicUrl": "",
    "mail": {
      "transport": "log",
      "from": "",
      "smtp": {
        "host": "",
        "port": 587,
        "secure": false,
        "user": "",
        "pass": ""
      },
      "file": {
        "dir": ".cms-mail"
      }
    },
    "storage": {
      "driver": "local",
      "local": {
        "dir": ".cms-uploads",
        "publicBase": "/api/cms/_media/raw"
      },
      "s3": {
        "endpoint": "",
        "region": "",
        "bucket": "",
        "accessKeyId": "",
        "secretAccessKey": "",
        "publicBaseUrl": "",
        "delivery": ""
      },
      "maxSizeMb": 10,
      "maxBytesPerUser": 0,
      "uploadRatePerMin": 60
    },
    "forms": {
      "notifyTo": "",
      "turnstileSecret": ""
    },
    "status": {
      "token": ""
    },
    "content": {
      "token": "",
      "cacheControl": "",
      "publicUrl": "",
      "docs": ""
    }
  },
  "runtimeConfig.public": {
    "cmsPlugins": {
      "plugins": [],
      "navItems": [],
      "fields": {},
      "dashboardWidgets": [],
      "entityPanels": [],
      "messages": {}
    },
    "cmsTurnstileSiteKey": "",
    "cmsDemo": {
      "email": "",
      "password": ""
    }
  },
  "environment": [
    {
      "name": "NUXT_CMS_DATABASE_URL",
      "default": ""
