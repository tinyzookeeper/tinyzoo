{
  "name": "tinyzoo-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "play": "pnpm --filter playground dev",
    "play:build": "pnpm --filter playground build",
    "db:generate": "pnpm --filter playground db:generate",
    "db:migrate": "pnpm --filter playground db:migrate",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter playground typecheck && pnpm --filter tinyzoo-starter typecheck && pnpm --filter tinyzoo-web typecheck",
    "build": "node scripts/build-check.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "check:consumer": "node scripts/consumer-check.mjs"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^3.4.4",
    "@tinyzoo/client": "workspace:*",
    "tinyzoo": "workspace:*",
    "@tiptap/y-tiptap": "^3.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.2",
    "drizzle-orm": "^0.44.7",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "ws": "^8.21.0",
    "yjs": "^13.6.31"
  },
  "engines": {
    "node": ">=22"
  }
}
