{
  "name": "@tinyzoo/client",
  "version": "0.2.2",
  "type": "module",
  "description": "Tiny, dependency-free, strictly-typed client for the tinyzoo content API.",
  "license": "UNLICENSED",
  "homepage": "https://github.com/tinyzookeeper/tinyzoo/tree/main/packages/client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinyzookeeper/tinyzoo.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/tinyzookeeper/tinyzoo/issues"
  },
  "keywords": [
    "cms",
    "headless-cms",
    "client",
    "typescript",
    "fetch",
    "tinyzoo"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "README.md",
    "LICENSE",
    "src",
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "prepack": "unbuild"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "unbuild": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
