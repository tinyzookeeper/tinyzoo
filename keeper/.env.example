# Postgres for Keeper's own data (sites, checks, accounts).
NUXT_DATABASE_URL=postgres://cms:cms@localhost:5434/keeper
# Seals the sign-in cookie (32+ characters).
NUXT_APP_SECRET=change-me-to-32-or-more-random-characters
# Encrypts the sites' status tokens (32+ characters). Keep it: a new one makes them unreadable.
NUXT_KEEPER_SECRET=change-me-to-another-32-or-more-random-characters
# Asked for when the first account is made (required in production).
NUXT_SETUP_TOKEN=
# Keeper's own address, for links in alert e-mails.
NUXT_PUBLIC_URL=http://localhost:3100
# Alert e-mails: log (print) or smtp.
NUXT_MAIL_TRANSPORT=log
NUXT_MAIL_FROM=
NUXT_MAIL_SMTP_HOST=
NUXT_MAIL_SMTP_PORT=587
NUXT_MAIL_SMTP_USER=
NUXT_MAIL_SMTP_PASS=
