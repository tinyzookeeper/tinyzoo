# Postgres for Keeper's own data (sites, checks, accounts).
NUXT_DATABASE_URL=postgres://cms:cms@localhost:5434/keeper
# Seals the sign-in cookie (32+ characters).
NUXT_APP_SECRET=change-me-to-32-or-more-random-characters
# Encrypts the sites' status tokens (32+ characters). Keep it: a new one makes them unreadable.
NUXT_KEEPER_SECRET=change-me-to-another-32-or-more-random-characters
# Asked for when the first account is made (required in production).
NUXT_SETUP_TOKEN=
# Keeper's own address, for links in alert e-mails.
NUXT_PUBLIC_URL=http://localhost:3100
# E-mail (alerts and invitations): log (print only; invitations show their link to copy) or smtp.
NUXT_MAIL_TRANSPORT=log
# The sender, e.g. Keeper <keeper@example.com> (default: the SMTP user).
NUXT_MAIL_FROM=
# Any SMTP server. Zimbra: port 587 with REQUIRE_TLS=true (STARTTLS), or 465 with SECURE=true.
NUXT_MAIL_SMTP_HOST=
NUXT_MAIL_SMTP_PORT=587
NUXT_MAIL_SMTP_SECURE=false
NUXT_MAIL_SMTP_REQUIRE_TLS=true
NUXT_MAIL_SMTP_USER=
NUXT_MAIL_SMTP_PASS=
# false accepts a certificate that does not verify (a self-signed one).
NUXT_MAIL_SMTP_TLS_REJECT_UNAUTHORIZED=true
# The host name Keeper greets the server with (default: this machine's).
NUXT_MAIL_SMTP_NAME=
