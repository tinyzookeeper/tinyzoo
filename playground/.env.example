# Copy to .env for local development (pnpm play). In production these come from the
# platform: Pushbase injects DATABASE_URL / REDIS_URL for linked services.

# Postgres (compose.yaml: docker compose up -d postgres)
DATABASE_URL=postgres://cms:cms@localhost:5434/cms

# Required: seals the sign-in cookie. At least 32 characters (openssl rand -base64 32).
NUXT_SESSION_PASSWORD=

# The admin's public address — used in invitation and password-reset emails.
NUXT_CMS_PUBLIC_URL=http://localhost:3000

# Apply bundled migrations when the server starts (production containers).
# NUXT_CMS_MIGRATIONS_ON_START=true

# Shared state between replicas: rate limits, realtime, cache invalidation.
# REDIS_URL=redis://localhost:6383

# Email: log (prints to the console) | file | smtp
NUXT_CMS_MAIL_TRANSPORT=log
# NUXT_CMS_MAIL_FROM="Web <web@example.com>"
# NUXT_CMS_MAIL_SMTP_HOST=localhost
# NUXT_CMS_MAIL_SMTP_PORT=1025

# Media: local (dev only — containers lose their disk) | s3
NUXT_CMS_STORAGE_DRIVER=local
# NUXT_CMS_STORAGE_S3_ENDPOINT=https://fsn1.your-objectstorage.com
# NUXT_CMS_STORAGE_S3_REGION=eu-central
# NUXT_CMS_STORAGE_S3_BUCKET=
# NUXT_CMS_STORAGE_S3_ACCESS_KEY_ID=
# NUXT_CMS_STORAGE_S3_SECRET_ACCESS_KEY=
# NUXT_CMS_STORAGE_S3_PUBLIC_BASE_URL=

# Publish webhooks to the website (comma separated) and their signing secret.
# NUXT_CMS_WEBHOOKS_URLS=https://www.example.com/api/cms-hook
# NUXT_CMS_WEBHOOKS_SECRET=

# Public content API token ('' = open).
# NUXT_CMS_CONTENT_TOKEN=
