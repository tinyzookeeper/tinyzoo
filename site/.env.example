# Copy to .env for development.
DATABASE_URL=postgres://cms:cms@localhost:5434/tinyzoo_web
# At least 32 characters (openssl rand -base64 32); the admin's sign-in cookie is sealed with a key derived from it.
# Production needs one of its own, set in the platform's environment. In development Nuxt makes one when it is empty.
NUXT_APP_SECRET=
# The website's address (emails, sitemap). In development it comes from the request.
# NUXT_CMS_PUBLIC_URL=https://www.example.cz
# Who hears about new form messages when nobody is set in the admin.
# NUXT_CMS_FORMS_NOTIFY_TO=office@example.cz
